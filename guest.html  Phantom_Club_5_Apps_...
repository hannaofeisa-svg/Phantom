<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#09090b">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; font-family: 'Cairo', sans-serif; -webkit-tap-highlight-color: transparent; }
  body { margin: 0; background: #09090b; color: #f4f4f5; min-height: 100vh; }
  .gold { color: #d4af37; }
  .card { background: #141418; border: 1px solid #27272f; border-radius: 16px; padding: 16px; }
  .btn { border: none; border-radius: 12px; padding: 11px 16px; font-weight: 700; font-size: 14px; cursor: pointer; transition: 0.15s; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .btn:active { transform: scale(0.97); }
  .btn-primary { background: linear-gradient(135deg, #d4af37, #b38b22); color: #09090b; }
  .btn-dark { background: #22222a; color: #e4e4e7; border: 1px solid #32323e; }
  input, select, textarea { width: 100%; background: #0d0d11; border: 1px solid #2e2e38; color: #fff; padding: 11px 12px; border-radius: 12px; font-size: 15px; outline: none; }
  input:focus, select:focus, textarea:focus { border-color: #d4af37; }
  .pill { display:inline-block; padding:5px 12px; border-radius:999px; background:#1e1e26; border:1px solid #32323e; font-size:13px; cursor:pointer; margin:3px; }
  .pill:hover { border-color:#d4af37; color:#d4af37; }
</style>
<title>Phantom Club | خدمة الطاولة</title></head><body>
<div id="closedScreen" style="display:none; max-width:440px; margin:70px auto; padding:20px; text-align:center;">
  <div class="card"><h1 class="gold" style="margin-top:0;">PHANTOM CLUB</h1><p style="font-size:16px; line-height:1.7;">عذراً، الخدمة متاحة خلال أوقات عمل النادي فقط (11:30 مساءً – 3:20 صباحاً بتوقيت الإمارات).</p></div>
</div>
<div id="loginScreen" style="max-width:420px; margin:40px auto; padding:18px;">
  <div class="card" style="text-align:center;">
    <h1 class="gold" style="margin:0 0 6px;">PHANTOM CLUB</h1><p style="color:#a1a1aa; margin:0 0 18px; font-size:14px;">أدخل رقم الطاولة وكود التفعيل من الكاونتر</p>
    <div style="text-align:right; margin-bottom:12px;"><label style="font-size:13px; color:#a1a1aa;">رقم الطاولة</label><select id="guestTableSelect"></select></div>
    <div style="text-align:right; margin-bottom:16px;"><label style="font-size:13px; color:#a1a1aa;">كود الطاولة (4 أرقام)</label><input type="tel" id="guestCodeInput" maxlength="4" placeholder="----" style="text-align:center; font-size:22px; letter-spacing:8px;"></div>
    <button class="btn btn-primary" style="width:100%;" onclick="verifyGuest()">دخول إلى الطاولة</button>
    <div id="loginError" style="color:#ef4444; font-size:13px; margin-top:10px;"></div>
  </div>
</div>
<div id="guestApp" style="display:none; max-width:520px; margin:0 auto; padding:16px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
    <div><h2 class="gold" style="margin:0;">طاولة #<span id="activeTableNum"></span></h2><div style="font-size:13px; color:#a1a1aa;">الويتر المسؤول: <strong id="activeWaiterName" style="color:#fff;"></strong></div></div>
    <button class="btn btn-dark" style="padding:7px 12px; font-size:12px;" onclick="logoutGuest()">تغيير الطاولة</button>
  </div>
  <div class="card" style="text-align:center; margin-bottom:14px;">
    <button class="btn btn-primary" style="width:100%; padding:14px; font-size:16px;" onclick="sendCallWaiter()">🔔 استدعاء الويتر إلى الطاولة</button>
    <div id="callFeedback" style="font-size:13px; color:#22c55e; margin-top:8px;"></div>
  </div>
  <div class="card" style="margin-bottom:14px;">
    <h3 style="margin:0 0 8px; color:#d4af37; font-size:16px;">🍾 طلب إضافي / خدمة سريعة</h3>
    <div style="margin-bottom:10px;">
      <span class="pill" onclick="fillOrder('ثلج إضافي')">ثلج إضافي</span><span class="pill" onclick="fillOrder('كؤوس إضافية')">كؤوس إضافية</span>
      <span class="pill" onclick="fillOrder('مياه')">مياه</span><span class="pill" onclick="fillOrder('تنظيف الطاولة')">تنظيف الطاولة</span><span class="pill" onclick="fillOrder('طلب الفاتورة')">طلب الفاتورة</span>
    </div>
    <div style="display:flex; gap:8px;"><input type="text" id="orderInput" placeholder="اكتب طلبك هنا..."><button class="btn btn-primary" onclick="sendOrder()">إرسال</button></div>
    <div id="orderFeedback" style="font-size:13px; color:#22c55e; margin-top:8px;"></div>
  </div>
  <div class="card" style="margin-bottom:14px;">
    <h3 style="margin:0 0 8px; color:#d4af37; font-size:16px;">✨ إرسال تحية أو تهنئة على الشاشة</h3>
    <input type="text" id="greetingInput" maxlength="90" placeholder="مثال: Happy Birthday Sarah 🎉 أو مبروك..." style="margin-bottom:8px;">
    <button class="btn btn-primary" style="width:100%;" onclick="sendGreeting()">إرسال التحية للشاشة</button>
    <div id="greetingFeedback" style="font-size:13px; color:#22c55e; margin-top:8px;"></div>
  </div>
  <div class="card"><h3 style="margin:0 0 8px; font-size:15px; color:#a1a1aa;">حالة طلباتك الأخيرة</h3><div id="myRequestsBox" style="display:flex; flex-direction:column; gap:8px;"></div></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/gun/gun.js"></script>
<script>
  const PHANTOM_ROOM = 'phantom_club_abudhabi_live_v3_roster12_2026';
  const gun = Gun(['https://gun-manhattan.herokuapp.com/gun', 'https://relay.peer.ooo/gun']);
  const db = gun.get(PHANTOM_ROOM);
  const bc = new BroadcastChannel(PHANTOM_ROOM);
  const ROSTER_WAITERS = {
    'W1': { id: 'W1', name: 'Amira', active: true }, 'W2': { id: 'W2', name: 'Hussen', active: true },
    'W3': { id: 'W3', name: 'Haydar Mahmoud', active: true }, 'W4': { id: 'W4', name: 'Vina', active: true },
    'W5': { id: 'W5', name: 'Nada', active: true }, 'W6': { id: 'W6', name: 'Samara', active: true },
    'W7': { id: 'W7', name: 'Adel', active: true }, 'W8': { id: 'W8', name: 'Makdeis', active: true },
    'W9': { id: 'W9', name: 'Haidar', active: true }, 'W10': { id: 'W10', name: 'Rita', active: true },
    'W11': { id: 'W11', name: 'Somar', active: true }, 'W12': { id: 'W12', name: 'Karim', active: true }
  };
  const ROSTER_SECTIONS = {
    'S01': { id: 'S01', num: 1, name: 'Section 1', tables: [1,61,62,51,52,53,54,55,56,57,58,70,71,72,73,74,75,76,77,78], waiterId: 'W1' },
    'S02': { id: 'S02', num: 2, name: 'Section 2', tables: [2,3], waiterId: 'W2' },
    'S03': { id: 'S03', num: 3, name: 'Section 3', tables: [4,5,6], waiterId: 'W3' },
    'S04': { id: 'S04', num: 4, name: 'Section 4', tables: [11,21,31,41], waiterId: 'W4' },
    'S05': { id: 'S05', num: 5, name: 'Section 5', tables: [12,22,32,42], waiterId: 'W5' },
    'S06': { id: 'S06', num: 6, name: 'Section 6', tables: [14,23,33,43], waiterId: 'W6' },
    'S07': { id: 'S07', num: 7, name: 'Section 7', tables: [15,24,34,44], waiterId: 'W7' },
    'S08': { id: 'S08', num: 8, name: 'Section 8', tables: [16,25,35,45], waiterId: 'W8' },
    'S09': { id: 'S09', num: 9, name: 'Section 9', tables: [26,36,46,47], waiterId: 'W9' },
    'S10': { id: 'S10', num: 10, name: 'Section 10', tables: [91,92,93], waiterId: 'W10' },
    'S11': { id: 'S11', num: 11, name: 'Section 11', tables: [7,8,9], waiterId: 'W11' },
    'S12': { id: 'S12', num: 12, name: 'Section 12', tables: [94,95,96], waiterId: 'W12' }
  };
  function getAllConfiguredTables() {
    const set = new Set();
    Object.values(window.PhantomState.sections || {}).forEach(sec => (sec.tables || []).forEach(t => set.add(Number(t))));
    return [...set].sort((a,b) => a - b);
  }
  window.PhantomState = {
    settings: { openHour: 23, openMin: 30, closeHour: 3, closeMin: 20, forceMode: 'auto', adminPin: '0000', waiterPin: '9999' },
    waiters: JSON.parse(JSON.stringify(ROSTER_WAITERS)), sections: JSON.parse(JSON.stringify(ROSTER_SECTIONS)),
    tables: {}, requests: {}, greetings: {}
  };
  try {
    const cached = JSON.parse(localStorage.getItem(PHANTOM_ROOM) || '{}');
    if (cached.settings) Object.assign(window.PhantomState.settings, cached.settings);
    if (cached.waiters && Object.keys(cached.waiters).length > 0) window.PhantomState.waiters = cached.waiters;
    if (cached.sections && Object.keys(cached.sections).length > 0) window.PhantomState.sections = cached.sections;
    if (cached.tables) window.PhantomState.tables = cached.tables;
    if (cached.requests) window.PhantomState.requests = cached.requests;
    if (cached.greetings) window.PhantomState.greetings = cached.greetings;
  } catch(e) {}
  function saveLocal() { localStorage.setItem(PHANTOM_ROOM, JSON.stringify(window.PhantomState)); bc.postMessage({ type: 'SYNC', state: window.PhantomState }); }
  bc.onmessage = (ev) => { if (ev.data && ev.data.type === 'SYNC') { window.PhantomState = ev.data.state; if (typeof window.onPhantomUpdate === 'function') window.onPhantomUpdate(); } };
  ['settings','waiters','sections','tables','requests','greetings'].forEach(col => {
    if (col === 'settings') {
      db.get('settings').on((data) => { if (!data) return; const clean = { ...data }; delete clean._; Object.assign(window.PhantomState.settings, clean); saveLocal(); if (typeof window.onPhantomUpdate === 'function') window.onPhantomUpdate(); });
    } else {
      db.get(col).map().on((data, key) => {
        if (!data) return; const clean = { ...data }; delete clean._;
        if (col === 'sections' && typeof clean.tables === 'string') { try { clean.tables = JSON.parse(clean.tables); } catch(e) { clean.tables = []; } }
        window.PhantomState[col][key] = clean; saveLocal(); if (typeof window.onPhantomUpdate === 'function') window.onPhantomUpdate();
      });
    }
  });
  window.PhantomAPI = {
    getAllTables() { return getAllConfiguredTables(); },
    getSectionForTable(tableNum) {
      const num = Number(tableNum);
      for (const sec of Object.values(window.PhantomState.sections)) {
        const arr = Array.isArray(sec.tables) ? sec.tables.map(Number) : [];
        if (arr.includes(num)) return sec;
      }
      return null;
    },
    getEffectiveWaiterId(tableNum) {
      const k = String(tableNum); const tObj = window.PhantomState.tables[k];
      if (tObj && tObj.waiterId) return tObj.waiterId;
      const sec = this.getSectionForTable(Number(tableNum)); return sec ? sec.waiterId : '';
    },
    addRequest(req) { const assignedW = req.waiterId || this.getEffectiveWaiterId(req.table); const fullReq = { ...req, waiterId: assignedW }; window.PhantomState.requests[fullReq.id] = fullReq; db.get('requests').get(fullReq.id).put(fullReq); saveLocal(); if (typeof window.onPhantomUpdate === 'function') window.onPhantomUpdate(); },
    addGreeting(gr) { window.PhantomState.greetings[gr.id] = gr; db.get('greetings').get(gr.id).put(gr); saveLocal(); if (typeof window.onPhantomUpdate === 'function') window.onPhantomUpdate(); },
    isClubOpen() {
      const s = window.PhantomState.settings;
      if (s.forceMode === 'open') return true; if (s.forceMode === 'closed') return false;
      const now = new Date(); const utc = now.getTime() + (now.getTimezoneOffset() * 60000); const uae = new Date(utc + (3600000 * 4));
      const mins = uae.getHours() * 60 + uae.getMinutes();
      const openMins = (Number(s.openHour) || 23) * 60 + (Number(s.openMin) || 30);
      const closeMins = (Number(s.closeHour) || 3) * 60 + (Number(s.closeMin) || 20);
      return openMins > closeMins ? (mins >= openMins || mins < closeMins) : (mins >= openMins && mins < closeMins);
    },
    getUAETimeString() { const now = new Date(); const utc = now.getTime() + (now.getTimezoneOffset() * 60000); const uae = new Date(utc + (3600000 * 4)); return uae.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true }); }
  };
  const tSelect = document.getElementById('guestTableSelect');
  function populateGuestTables() {
    const prev = tSelect.value; tSelect.innerHTML = '';
    window.PhantomAPI.getAllTables().forEach(t => {
      const sec = window.PhantomAPI.getSectionForTable(t);
      tSelect.innerHTML += `<option value="${t}">طاولة رقم ${t} ${sec ? '(' + sec.name + ')' : ''}</option>`;
    });
    if (prev && tSelect.querySelector(`option[value="${prev}"]`)) tSelect.value = prev;
  }
  populateGuestTables();
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('table')) setTimeout(() => { if (tSelect.querySelector(`option[value="${urlParams.get('table')}"]`)) tSelect.value = urlParams.get('table'); }, 50);
  let sessionTable = null;
  function checkClubAndSession() {
    const isOpen = window.PhantomAPI.isClubOpen();
    document.getElementById('closedScreen').style.display = isOpen ? 'none' : 'block';
    if (!isOpen) { document.getElementById('loginScreen').style.display = 'none'; document.getElementById('guestApp').style.display = 'none'; return; }
    if (sessionTable) {
      const tObj = window.PhantomState.tables[String(sessionTable)];
      if (!tObj || tObj.status !== 'active') { logoutGuest(); return; }
      document.getElementById('loginScreen').style.display = 'none'; document.getElementById('guestApp').style.display = 'block';
      document.getElementById('activeTableNum').innerText = sessionTable;
      const effWaiterId = window.PhantomAPI.getEffectiveWaiterId(sessionTable);
      document.getElementById('activeWaiterName').innerText = (window.PhantomState.waiters[effWaiterId] || {}).name || 'الويتر';
      renderMyRequests();
    } else { document.getElementById('loginScreen').style.display = 'block'; document.getElementById('guestApp').style.display = 'none'; }
  }
  function verifyGuest() {
    const tNum = tSelect.value; const code = document.getElementById('guestCodeInput').value.trim();
    const tObj = window.PhantomState.tables[String(tNum)];
    if (!tObj || tObj.status !== 'active' || tObj.code !== code) { document.getElementById('loginError').innerText = 'رقم الطاولة أو الكود غير صحيح أو الطاولة غير مفعّلة.'; return; }
    sessionTable = tNum; document.getElementById('loginError').innerText = ''; checkClubAndSession();
  }
  function logoutGuest() { sessionTable = null; document.getElementById('guestCodeInput').value = ''; checkClubAndSession(); }
  function sendCallWaiter() {
    const waiterId = window.PhantomAPI.getEffectiveWaiterId(sessionTable);
    window.PhantomAPI.addRequest({ id: 'req_' + Date.now() + '_' + Math.random().toString(36).slice(2,6), table: String(sessionTable), waiterId, type: 'call', text: 'استدعاء إلى الطاولة', status: 'pending', createdAt: Date.now(), timeStr: window.PhantomAPI.getUAETimeString() });
    document.getElementById('callFeedback').innerText = 'تم إرسال استدعاء الويتر بنجاح ✓'; setTimeout(() => document.getElementById('callFeedback').innerText = '', 3000);
  }
  function fillOrder(txt) { document.getElementById('orderInput').value = txt; }
  function sendOrder() {
    const txt = document.getElementById('orderInput').value.trim(); if (!txt) return;
    const waiterId = window.PhantomAPI.getEffectiveWaiterId(sessionTable);
    window.PhantomAPI.addRequest({ id: 'req_' + Date.now() + '_' + Math.random().toString(36).slice(2,6), table: String(sessionTable), waiterId, type: 'order', text: txt, status: 'pending', createdAt: Date.now(), timeStr: window.PhantomAPI.getUAETimeString() });
    document.getElementById('orderInput').value = ''; document.getElementById('orderFeedback').innerText = 'تم إرسال طلبك بنجاح ✓'; setTimeout(() => document.getElementById('orderFeedback').innerText = '', 3000);
  }
  function sendGreeting() {
    const txt = document.getElementById('greetingInput').value.trim(); if (!txt) return;
    window.PhantomAPI.addGreeting({ id: 'gr_' + Date.now() + '_' + Math.random().toString(36).slice(2,6), table: String(sessionTable), text: txt, status: 'pending', createdAt: Date.now(), timeStr: window.PhantomAPI.getUAETimeString() });
    document.getElementById('greetingInput').value = ''; document.getElementById('greetingFeedback').innerText = 'تم إرسال تحيتك للمراجعة والعرض على الشاشة ✓'; setTimeout(() => document.getElementById('greetingFeedback').innerText = '', 3500);
  }
  function renderMyRequests() {
    const box = document.getElementById('myRequestsBox'); box.innerHTML = '';
    const mine = Object.values(window.PhantomState.requests).filter(r => String(r.table) === String(sessionTable)).sort((a,b) => b.createdAt - a.createdAt).slice(0, 6);
    if (!mine.length) { box.innerHTML = '<div style="color:#71717a; font-size:13px;">لا توجد طلبات بعد.</div>'; return; }
    mine.forEach(r => {
      const st = r.status === 'done' ? '<span style="color:#22c55e;">تم التنفيذ ✓</span>' : '<span style="color:#eab308;">قيد الانتظار...</span>';
      box.innerHTML += `<div style="background:#0d0d11; padding:9px 12px; border-radius:10px; display:flex; justify-content:space-between; font-size:13px;"><span>${r.text}</span>${st}</div>`;
    });
  }
  window.onPhantomUpdate = () => { populateGuestTables(); checkClubAndSession(); };
  checkClubAndSession(); setInterval(checkClubAndSession, 10000);
</script>
</body></html>
