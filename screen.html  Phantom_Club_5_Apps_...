<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#09090b">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; font-family: 'Cairo', sans-serif; -webkit-tap-highlight-color: transparent; }
  body { margin: 0; background: #050507; color: #f4f4f5; min-height: 100vh; overflow: hidden; }
  .gold { color: #d4af37; }
  .btn { border: none; border-radius: 12px; padding: 11px 16px; font-weight: 700; font-size: 14px; cursor: pointer; transition: 0.15s; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .btn-primary { background: linear-gradient(135deg, #d4af37, #b38b22); color: #09090b; }
  .btn-danger { background: #dc2626; color: #fff; }
  .btn-success { background: #16a34a; color: #fff; }
  .btn-dark { background: #22222a; color: #e4e4e7; border: 1px solid #32323e; }
  .mod-bar { position: fixed; bottom: 14px; left: 14px; right: 14px; z-index: 50; background: rgba(20,20,24,0.94); border: 1px solid #32323e; border-radius: 16px; padding: 12px; max-height: 45vh; overflow-y: auto; }
  .stage { height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 30px; background: radial-gradient(circle at center, #1b1608 0%, #050507 70%); }
  .greeting-text { font-size: clamp(34px, 6vw, 76px); font-weight: 900; line-height: 1.3; color: #fff; text-shadow: 0 0 30px rgba(212,175,55,0.35); max-width: 1100px; }
  .greeting-table { margin-top: 18px; font-size: clamp(20px, 3vw, 36px); font-weight: 700; color: #d4af37; }
</style>
<title>Phantom Club | شاشة التحيات</title></head><body>
<div class="stage">
  <div style="font-size:18px; letter-spacing:4px; color:#d4af37; font-weight:700; margin-bottom:14px;">PHANTOM CLUB • ABU DHABI</div>
  <div id="displayArea"><div class="greeting-text gold">أهلاً بكم في فانتوم كلوب ✨</div><div class="greeting-table">نتمنى لكم ليلة مميزة</div></div>
</div>
<div style="position:fixed; top:14px; left:14px; z-index:60;"><button class="btn btn-dark" onclick="toggleMod()">اعتماد التحيات (<span id="pendingCount">0</span>)</button></div>
<div id="modPanel" class="mod-bar" style="display:none;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;"><strong class="gold">تحيات الزبائن بانتظار الموافقة</strong><button class="btn btn-dark" style="padding:5px 10px; font-size:12px;" onclick="toggleMod()">إغلاق</button></div>
  <div id="pendingGreetingsList" style="display:flex; flex-direction:column; gap:8px;"></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/gun/gun.js"></script>
<script>
  const PHANTOM_ROOM = 'phantom_club_abudhabi_live_v3_roster12_2026';
  const gun = Gun(['https://gun-manhattan.herokuapp.com/gun', 'https://relay.peer.ooo/gun']);
  const db = gun.get(PHANTOM_ROOM);
  const bc = new BroadcastChannel(PHANTOM_ROOM);
  window.PhantomState = { settings: {}, waiters: {}, sections: {}, tables: {}, requests: {}, greetings: {} };
  try {
    const cached = JSON.parse(localStorage.getItem(PHANTOM_ROOM) || '{}');
    if (cached.greetings) window.PhantomState.greetings = cached.greetings;
  } catch(e) {}
  function saveLocal() { localStorage.setItem(PHANTOM_ROOM, JSON.stringify(window.PhantomState)); bc.postMessage({ type: 'SYNC', state: window.PhantomState }); }
  bc.onmessage = (ev) => { if (ev.data && ev.data.type === 'SYNC') { window.PhantomState = ev.data.state; if (typeof window.onPhantomUpdate === 'function') window.onPhantomUpdate(); } };
  db.get('greetings').map().on((data, key) => {
    if (!data) return; const clean = { ...data }; delete clean._;
    window.PhantomState.greetings[key] = clean; saveLocal(); if (typeof window.onPhantomUpdate === 'function') window.onPhantomUpdate();
  });
  window.PhantomAPI = {
    updateGreeting(id, patch) { if (window.PhantomState.greetings[id]) { Object.assign(window.PhantomState.greetings[id], patch); db.get('greetings').get(id).put(patch); saveLocal(); if (typeof window.onPhantomUpdate === 'function') window.onPhantomUpdate(); } }
  };
  let queue = []; let shownIds = new Set(); let currentShowing = null;
  function toggleMod() { const p = document.getElementById('modPanel'); p.style.display = p.style.display === 'none' ? 'block' : 'none'; }
  function approveGreeting(id) { window.PhantomAPI.updateGreeting(id, { status: 'approved', approvedAt: Date.now() }); }
  function rejectGreeting(id) { window.PhantomAPI.updateGreeting(id, { status: 'rejected' }); }
  function renderScreen() {
    const all = Object.values(window.PhantomState.greetings || {});
    const pending = all.filter(g => g.status === 'pending').sort((a,b) => a.createdAt - b.createdAt);
    document.getElementById('pendingCount').innerText = pending.length;
    const pList = document.getElementById('pendingGreetingsList'); pList.innerHTML = '';
    if (!pending.length) pList.innerHTML = '<div style="color:#a1a1aa; font-size:13px;">لا توجد تحيات بانتظار الموافقة.</div>';
    pending.forEach(g => {
      pList.innerHTML += `<div style="background:#0d0d11; padding:10px; border-radius:10px; display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;"><div><strong class="gold">طاولة #${g.table}:</strong> <span>${g.text}</span></div><div style="display:flex; gap:6px;"><button class="btn btn-success" style="padding:6px 12px; font-size:12px;" onclick="approveGreeting('${g.id}')">عرض على الشاشة ✓</button><button class="btn btn-danger" style="padding:6px 12px; font-size:12px;" onclick="rejectGreeting('${g.id}')">رفض</button></div></div>`;
    });
    all.filter(g => g.status === 'approved' && !shownIds.has(g.id)).sort((a,b) => (a.approvedAt || a.createdAt) - (b.approvedAt || b.createdAt)).forEach(g => { shownIds.add(g.id); queue.push(g); });
    pumpQueue();
  }
  function pumpQueue() {
    if (currentShowing || !queue.length) return;
    currentShowing = queue.shift();
    document.getElementById('displayArea').innerHTML = `<div class="greeting-text">${currentShowing.text}</div><div class="greeting-table">من طاولة #${currentShowing.table} ✨</div>`;
    setTimeout(() => {
      currentShowing = null;
      if (!queue.length) document.getElementById('displayArea').innerHTML = `<div class="greeting-text gold">أهلاً بكم في فانتوم كلوب ✨</div><div class="greeting-table">نتمنى لكم ليلة مميزة</div>`;
      pumpQueue();
    }, 8000);
  }
  window.onPhantomUpdate = renderScreen; renderScreen();
</script>
</body></html>
